<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Window shared by the launch and running themes (Dark Mode on): the
         splash color behind see-through system bars whose icons stay
         readable on it. The Flutter splash draws its logo on the same color. -->
    <style name="LocalMindWindow" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
    <!-- Theme applied to the Android Window while the process is starting.
         Automatically removed when the Flutter engine draws its first frame. -->
    <style name="LaunchTheme" parent="LocalMindWindow">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has
         started, behind the Flutter UI while it runs. -->
    <style name="NormalTheme" parent="LocalMindWindow" />
</resources>
