<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ in Dark Mode. Night outranks the API level when Android picks
         resources, so this repeats values-v31 or values-night would win.
         Android 12+ draws its own splash: show only the splash color there,
         without the launcher icon. The Flutter splash then draws the logo. -->
    <style name="LaunchTheme" parent="LocalMindWindow">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_blank</item>
    </style>
</resources>
